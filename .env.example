# Server
PORT=3000
NODE_ENV=development

# Persistence
DATABASE_PATH=./data/artefactor.db
ARTEFACTOR_PAYLOAD_DIR=./data/payloads
MIGRATIONS_DIR=./src/infra/db/migrations

# Artefact card thumbnails (S37): the isolated renderer's base URL. Unset = no
# thumbnails (cards show the kind placeholder); never point it at a renderer that
# is not isolated — see docs/renderer-isolation.md.
# ARTEFACTOR_RENDERER_URL=http://localhost:3001
ARTEFACTOR_THUMBNAIL_DIR=./data/thumbnails

# Static client (built by `pnpm build:client`)
CLIENT_DIR=./dist/client

BETTER_AUTH_SECRET=        # required in production; openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000
AUTH_TRUSTED_ORIGINS=http://localhost:5273

# Sign-in methods (S38 / IA7). A production deployment needs at least one: set
# both Google credentials, or AUTH_EMAIL_PASSWORD=true — otherwise the server
# refuses to boot. Unset, email+password is on outside production and off in it.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# AUTH_EMAIL_PASSWORD=true

# Account creation (IA 4). Unset, the gate is closed only when production has the
# unverified email+password path open, and open otherwise. The usual lifecycle on
# a fixed-team deployment: open it, create the accounts, set it back to false.
# AUTH_ALLOW_SIGNUP=false

# Optional: serve artefact frames from a separate registrable domain (not the app's
# host, a subdomain of it, or a parent domain of it). Unset = frames stay on the app
# host, isolated by the sandbox alone.
# ARTEFACTOR_CONTENT_ORIGIN=https://artefactor-content.com
