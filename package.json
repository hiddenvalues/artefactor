{
  "name": "artefactor",
  "version": "0.0.0",
  "description": "Hosts and serves trusted HTML artefacts produced by claude.ai / Claude design.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k -n client,server -c cyan,magenta \"vite\" \"tsx watch src/server/index.ts\"",
    "dev:local": "portless run tsx src/dev/dev-local.ts",
    "dev:seed": "tsx src/dev/seed-demo.ts",
    "dev:renderer": "ARTEFACTOR_RENDERER_EXIT_AFTER_JOB=false tsx src/renderer/index.ts",
    "build": "pnpm build:client && pnpm build:server",
    "build:client": "vite build",
    "build:server": "esbuild src/server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server/index.js && esbuild src/infra/db/migrate.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server/migrate.js && esbuild src/infra/export/cli.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server/export.js && pnpm build:renderer",
    "build:renderer": "esbuild src/renderer/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/renderer/index.js",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "test:unit": "vitest run --exclude '**/*.browser.test.ts'",
    "test:browser": "vitest run .browser.test.ts",
    "test:watch": "vitest",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/infra/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "export:bundle": "tsx src/infra/export/cli.ts",
    "spec:dag": "tsx src/specs/spec-dag.ts",
    "spec:trace": "tsx src/specs/spec-trace.ts",
    "spec:bump": "tsx src/specs/spec-bump.ts",
    "spec:req": "tsx src/specs/spec-req.ts",
    "quiet": "tsx src/dev/quiet.ts",
    "lint": "eslint src/client",
    "design:catalog": "vite --config vite.design.config.ts",
    "design:export": "vite build --config vite.design.config.ts",
    "lint:md": "markdownlint-cli2",
    "lint:md:fix": "markdownlint-cli2 --fix"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.4.0",
      "onFail": "download"
    }
  },
  "dependencies": {
    "@better-auth/mcp": "~1.7.7",
    "@better-auth/oauth-provider": "~1.7.7",
    "@hono/mcp": "^0.3.2",
    "@hono/node-server": "^2.1.3",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "better-auth": "~1.7.7",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.11",
    "jose": "^6.2.12",
    "lucide-react": "^1.48.0",
    "playwright-core": "^1.63.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-remove-scroll": "^2.7.2",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "markdownlint-cli2": "^0.23.3",
    "node-gyp": "^13.0.2",
    "portless": "0.15.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "yaml": "^2.9.1"
  }
}
