{
  "name": "artefactor",
  "version": "0.0.0",
  "description": "Hosts and serves trusted HTML artefacts produced by claude.ai / Claude design.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k -n client,server -c cyan,magenta \"vite\" \"tsx watch src/server/index.ts\"",
    "dev:renderer": "ARTEFACTOR_RENDERER_EXIT_AFTER_JOB=false tsx src/renderer/index.ts",
    "build": "pnpm build:client && pnpm build:server",
    "build:client": "vite build",
    "build:server": "esbuild src/server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server/index.js && esbuild src/infra/db/migrate.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server/migrate.js && esbuild src/infra/export/cli.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server/export.js && pnpm build:renderer",
    "build:renderer": "esbuild src/renderer/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/renderer/index.js",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/infra/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "export:bundle": "tsx src/infra/export/cli.ts",
    "spec:dag": "tsx src/specs/spec-dag.ts",
    "lint": "eslint src/client",
    "design:catalog": "vite --config vite.design.config.ts",
    "design:export": "vite build --config vite.design.config.ts",
    "lint:md": "markdownlint-cli2",
    "lint:md:fix": "markdownlint-cli2 --fix"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.4.0",
      "onFail": "download"
    }
  },
  "dependencies": {
    "@hono/mcp": "^0.3.0",
    "@hono/node-server": "^2.0.6",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-auth": "^1.6.20",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.27",
    "lucide-react": "^1.48.0",
    "playwright-core": "^1.63.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.3",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.1",
    "eslint": "^10.11.0",
    "markdownlint-cli2": "^0.23.2",
    "node-gyp": "^13.0.0",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.22.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "vitest": "^4.1.9",
    "yaml": "^2.9.1"
  }
}
