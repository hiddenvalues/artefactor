{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["node"],
    "noEmit": true
  },
  "include": [
    "src/server/**/*.ts",
    "src/domain/**/*.ts",
    "src/infra/**/*.ts",
    "src/renderer/**/*.ts",
    "src/shared/**/*.ts",
    "src/specs/**/*.ts",
    "src/deploy/**/*.ts"
  ]
}
